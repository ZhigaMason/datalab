#!/bin/bash
#PBS -N w2v-prep
#PBS -j oe
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=1:00:00
set -euo pipefail
# Fail fast if this node cannot reach /storage: a hung NFS mount blocks forever in uninterruptible
# I/O (seen on adan18/adan26), so probe in the background instead of waiting on it.
( stat "$PBS_O_WORKDIR" >/dev/null ) & probe=$!
for _ in $(seq "${STORAGE_PROBE_SECS:-60}"); do kill -0 "$probe" 2>/dev/null || break; sleep 1; done
if kill -0 "$probe" 2>/dev/null || ! wait "$probe"; then
    echo "storage $PBS_O_WORKDIR unreachable from $(hostname); resubmit this job" >&2
    exit 75
fi
cd "$PBS_O_WORKDIR"
source jobs/config.sh
: "${W2V_LANG:?set W2V_LANG}" "${NUM_SHARDS:?set NUM_SHARDS}" "${PBS_ARRAY_INDEX:?submit as an array job (-J)}"
w2v_py -m scripts.preprocess --lang "$W2V_LANG" --shard "$PBS_ARRAY_INDEX" --num-shards "$NUM_SHARDS" \
    --workers "${PBS_NCPUS:-8}" --data-dir "$W2V_DATA"
