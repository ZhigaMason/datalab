#!/bin/bash
#PBS -N w2v-train
#PBS -j oe
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:gpu_mem=20gb:mem=32gb:scratch_local=40gb
#PBS -l walltime=1:00:00
# One run per job (gpu queue). Env: W2V_LANG MODE JEPA DIM SEED [EPOCHS] [TRAIN_BUDGET].
set -euo pipefail
cd "$PBS_O_WORKDIR"
source jobs/config.sh
nvidia-smi || true
rc=0
WORK="$SCRATCHDIR/run" bash jobs/train_run.sh || rc=$?
if (( rc == 0 )); then clean_scratch || true; fi
exit "$rc"
